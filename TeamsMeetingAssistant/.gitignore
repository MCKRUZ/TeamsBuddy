## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Secrets and credentials (CRITICAL)
appsettings.Development.json
appsettings.*.json
!appsettings.json
**/TEMP_CREDENTIALS.txt
secrets/
*.key
*.secret

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/

# User-specific files
*.suo
*.user
*.sln.docstates

# Rider
.idea/
*.sln.iml

# Node modules (for any frontend tooling)
node_modules/
