@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace TeamsMeetingAssistant.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="TeamsMeetingAssistant.Web.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png"/>
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">??</a>
    </div>

    <!-- Microsoft Teams JavaScript SDK - Integrity removed for dev tunnel compatibility -->
    <script src="https://res.cdn.office.net/teams-js/2.19.0/js/MicrosoftTeams.min.js" 
            crossorigin="anonymous"
            onerror="console.error('[HOST] ? CRITICAL: Failed to load Teams SDK from CDN');">
    </script>
    
    <!-- Verify Teams SDK loaded -->
    <script>
        (function() {
            console.log('[HOST] ========== TEAMS SDK LOAD CHECK ==========');
            console.log('[HOST] Timestamp:', new Date().toISOString());
            console.log('[HOST] Current URL:', window.location.href);
            console.log('[HOST] Referrer:', document.referrer);
            console.log('[HOST] In iframe:', window !== window.top);
            
            if (typeof microsoftTeams !== 'undefined') {
                console.log('[HOST] ? Teams SDK loaded successfully');
                console.log('[HOST] Teams SDK version:', microsoftTeams.version);
                console.log('[HOST] Teams SDK object keys:', Object.keys(microsoftTeams));
            } else {
                console.error('[HOST] ? Teams SDK NOT loaded - microsoftTeams is undefined');
                console.error('[HOST] This will cause SSO to fail!');
                console.error('[HOST] Possible causes:');
                console.error('[HOST]   1. CDN blocked by network/firewall');
                console.error('[HOST]   2. CSP policy blocking script');
                console.error('[HOST]   3. Script failed to download');
                
                // Try to check CDN reachability
                fetch('https://res.cdn.office.net/teams-js/2.19.0/js/MicrosoftTeams.min.js', { method: 'HEAD' })
                    .then(response => {
                        console.log('[HOST] CDN reachability test:', {
                            status: response.status,
                            statusText: response.statusText,
                            ok: response.ok
                        });
                    })
                    .catch(error => {
                        console.error('[HOST] CDN reachability test failed:', error);
                    });
            }
            console.log('[HOST] ========================================');
        })();
    </script>

    <!-- Teams Authentication Helper -->
    <script src="js/teams-auth.js"></script>

    <script>
        console.log('[HOST] Host page loaded, about to load Blazor...');
        console.log('[HOST] Current URL:', window.location.href);
        console.log('[HOST] Microsoft Teams SDK available:', typeof microsoftTeams !== 'undefined');
        
        // Configure Blazor for dev tunnel
        window.Blazor = window.Blazor || {};
        window.Blazor.start = window.Blazor.start || function() {};
        
        // Dev tunnel specific configuration
        if (window.location.hostname.includes('devtunnels.ms')) {
            console.log('[HOST] Running through dev tunnel - applying dev tunnel configuration');
            
            // Configure Blazor SignalR connection for dev tunnels
            window.Blazor.defaultReconnectionHandler = {
                onConnectionDown: () => console.log('[HOST] Blazor connection lost'),
                onConnectionUp: () => console.log('[HOST] Blazor connection restored')
            };
        } else {
            console.log('[HOST] Running on localhost');
        }
        
        // Test framework endpoint before loading Blazor
        fetch('/_framework/blazor.server.js', { method: 'HEAD' })
            .then(response => {
                console.log('[HOST] Framework file check:', {
                    status: response.status,
                    contentType: response.headers.get('content-type'),
                    url: response.url
                });
            })
            .catch(error => {
                console.error('[HOST] Framework file check failed:', error);
            });
    </script>

    <script src="_framework/blazor.server.js" onerror="console.error('[HOST] ? Failed to load blazor.server.js')"></script>
    
    <script>
        console.log('[HOST] Blazor script loaded successfully');
        
        // Check if Blazor object is available
        if (typeof Blazor !== 'undefined') {
            console.log('[HOST] Blazor object is available');
            
            // Configure Blazor start options for dev tunnels
            if (window.location.hostname.includes('devtunnels.ms')) {
                console.log('[HOST] Configuring Blazor for dev tunnel...');
                Blazor.start({
                    configureSignalR: function (builder) {
                        console.log('[HOST] Configuring SignalR for dev tunnel');
                        return builder
                            .withUrl('/_blazor', {
                                transport: 1, // LongPolling only
                                timeout: 60000,
                                serverTimeoutInMilliseconds: 60000
                            });
                    }
                });
            }
        } else {
            console.error('[HOST] Blazor object is NOT available');
        }
        
        console.log('[HOST] ========== HOST INITIALIZATION COMPLETE ==========');
    </script>
</body>
</html>
